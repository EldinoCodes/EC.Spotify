@EC.Spotify.HostAddress = https://localhost:5001

#  UserTopType
#    Artists = 1
#    Tracks = 2

#  UserTopTimeRange
#    LongTerm = 0
#    MediumTerm = 1
#    ShortTerm = 2



### user my albums get all
GET {{EC.Spotify.HostAddress}}/User/albums
Accept: application/json

### user my albums get all (paged)
GET {{EC.Spotify.HostAddress}}/User/albums?offset=0&limit=20
Accept: application/json

### user my albums get all raw
GET {{EC.Spotify.HostAddress}}/User/albums/raw
Accept: application/json

### user my albums get all raw (paged)
GET {{EC.Spotify.HostAddress}}/User/albums/raw?offset=0&limit=20
Accept: application/json

### user my audiobooks get all
GET {{EC.Spotify.HostAddress}}/User/audiobooks
Accept: application/json

