### album
GET {{EC.Spotify.HostAddress}}/Albums/{{EC.Spotify.AlbumId}}
Accept: application/json

### album tracks
GET {{EC.Spotify.HostAddress}}/Albums/{{EC.Spotify.AlbumId}}/tracks
Accept: application/json



### artist
GET {{EC.Spotify.HostAddress}}/Artists/{{EC.Spotify.ArtistId}}
Accept: application/json

### artist albums
GET {{EC.Spotify.HostAddress}}/Artists/{{EC.Spotify.ArtistId}}/albums
Accept: application/json

### artist albums page
GET {{EC.Spotify.HostAddress}}/Artists/{{EC.Spotify.ArtistId}}/albums?offset=20&limit=20&albumTypes=album,single
Accept: application/json


### artist albums page
#  AlbumType
#    Album = 1,
#    Single =  2,
#    AppearsOn = 4,
#    Compilation = 8
GET {{EC.Spotify.HostAddress}}/Artists/{{EC.Spotify.ArtistId}}/albums?offset=20&limit=20&albumTypes=1,2
Accept: application/json



